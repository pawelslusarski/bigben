# Plik generowany automatycznie przy budowaniu strony (src/htaccess.njk) – nie edytuj go na serwerze.
# Serwer home.pl (IdeaWebServer) nie jest Apache'em: przekierowania działają tylko jako RewriteRule,
# a dyrektywy Redirect/RedirectMatch są ignorowane.
ErrorDocument 404 /404.html

# Serwer home.pl nie zna formatu WebP i bez tego wysyła zdjęcia jako plik do pobrania
AddType image/webp .webp
AddType image/heic .heic

RewriteEngine On

# Zawsze HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bez "www"
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Typ plików WebP (serwer home.pl ignoruje AddType)
RewriteRule \.webp$ - [T=image/webp]
RewriteRule \.ico$ - [T=image/x-icon]

# Pozostałości po WordPressie: nic tu już nie ma
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-json|wp-includes) - [F,L]

# Przekierowania starych adresów (WordPress) na nowe
{%- for p in przekierowania %}
RewriteRule ^{{ p.z | replace("/", "", 1) | replace(".", "\\.") }}?$ {{ p.do }} [R=301,L]
{%- endfor %}

# Stare pliki WordPressa (wp-content/uploads) leżą teraz w /media: zdjęcia jako WebP w jednym rozmiarze,
# pozostałe pliki (PDF, film) pod tą samą nazwą. Listę plików uzupełnia tools/pobierz-uploads.mjs.
RewriteRule ^wp-content/uploads/(.+)-[0-9]+x[0-9]+\.(jpe?g|png)$ /media/$1.webp [NC,R=301,L]
RewriteRule ^wp-content/uploads/(.+)\.(jpe?g|png)$ /media/$1.webp [NC,R=301,L]
RewriteRule ^wp-content/uploads/(.+)$ /media/$1 [R=301,L]

# Pozostałe stare adresy WordPressa: kanał RSS, kategorie, tagi, archiwa, nieznane wpisy
RewriteRule ^(comments/)?feed/?$ /aktualnosci/ [R=301,L]
RewriteRule ^(category|tag|author)/ /aktualnosci/ [R=301,L]
RewriteRule ^page/[0-9]+/?$ /aktualnosci/ [R=301,L]
RewriteRule ^[0-9]{4}/([0-9]{2}/)?([0-9]{2}/)?(.+/)?$ /aktualnosci/ [R=301,L]
RewriteRule ^index\.php$ / [R=301,L]

# Nagłówki. Serwer home.pl stosuje je do wszystkich plików (nie rozróżnia typów przez FilesMatch),
# dlatego pamięć podręczna jest krótka: zmiany na stronie widać najpóźniej po 5 minutach.
Header set Cache-Control "public, max-age=300"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header set Strict-Transport-Security "max-age=31536000"
