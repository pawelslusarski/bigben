---
permalink: /.htaccess
eleventyExcludeFromCollections: true
---
# Plik generowany automatycznie przy budowaniu strony (src/htaccess.njk) – nie edytuj go na serwerze.
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On
# Zawsze HTTPS i bez "www"
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Pozostałości po WordPressie: nic tu już nie ma
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-json|wp-includes)(/|$) - [R=410,L]
</IfModule>

# Przekierowania starych adresów (WordPress) na nowe
{%- for p in przekierowania %}
RedirectMatch 301 ^{{ p.z | replace(".", "\\.") }}?$ {{ p.do }}
{%- endfor %}

<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(woff2|webp|svg|png|jpe?g)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/xml application/xml
</IfModule>
