# Plik generowany automatycznie przy budowaniu strony (src/htaccess.njk) – nie edytuj go na serwerze.
# Serwer home.pl (IdeaWebServer) nie jest Apache'em: przekierowania działają tylko jako RewriteRule,
# a dyrektywy Redirect/RedirectMatch są ignorowane.
ErrorDocument 404 /404.html

RewriteEngine On

# Zawsze HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Bez "www"
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Pozostałości po WordPressie: nic tu już nie ma
RewriteRule ^(wp-login\.php|xmlrpc\.php|wp-admin|wp-json|wp-includes) - [F,L]

# Przekierowania starych adresów (WordPress) na nowe
{%- for p in przekierowania %}
RewriteRule ^{{ p.z | replace("/", "", 1) | replace(".", "\\.") }}?$ {{ p.do }} [R=301,L]
{%- endfor %}

# Nagłówki bezpieczeństwa i pamięć podręczna – działają tylko w środowisku Apache
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
Header always set Strict-Transport-Security "max-age=31536000"
<FilesMatch "\.(woff2|webp|svg|png|jpe?g)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
