---
layout: base.njk
title: Aktualności
opis: Aktualności szkoły języka angielskiego Big Ben w Kutnie – zapisy, wydarzenia, wyjazdy i porady.
pagination:
  data: collections.wpisy
  size: 12
  alias: strona
permalink: "/aktualnosci/{% if pagination.pageNumber > 0 %}strona/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<section class="sekcja">
  <header class="tytul-sekcji"><h1>Aktualności</h1></header>
  <div class="wpisy">
  {%- set poziom = "h2" %}
  {%- for w in strona %}
    {% include "karta.njk" %}
  {%- endfor %}
  </div>
  {%- if pagination.pages.length > 1 %}
  <nav class="stronicowanie" aria-label="Strony aktualności">
    {%- for href in pagination.hrefs %}
    {% if loop.index0 == pagination.pageNumber %}<span aria-current="page">{{ loop.index }}</span>{% else %}<a href="{{ href }}">{{ loop.index }}</a>{% endif %}
    {%- endfor %}
  </nav>
  {%- endif %}
</section>
